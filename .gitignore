# Dependencies and build output
node_modules/
dist/
coverage/

# Copied from node_modules/blockly/media by scripts/copy-blockly-media.mjs
public/blockly-media/

# The MCP bridge as one file, bundled from mcp-bridge/ by scripts/build-bridge.mjs
